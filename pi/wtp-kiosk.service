# Kiosk service: RFID reader + local web server.
# Installed as a user service so it has access to the desktop session.
#   systemctl --user status wtp-kiosk
[Unit]
Description=WTP Scale kiosk service (RFID reader + local server)
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=__REPO__
ExecStart=/usr/bin/python3 __REPO__/pi/reader.py --port 8080
Restart=always
RestartSec=3

[Install]
# default.target, not graphical-session.target: Wayfire on Pi OS never
# activates the latter in the user instance, so nothing wanted by it ever
# starts at boot. kiosk.sh waits for the display itself.
WantedBy=default.target
