# Kiosk service: RFID reader + local web server.
# Installed as a user service so it has access to the desktop session.
#   systemctl --user status wtp-kiosk
[Unit]
Description=WTP Scale kiosk service (RFID reader + local server)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/wtp-scale
ExecStart=/usr/bin/python3 %h/wtp-scale/pi/reader.py --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
