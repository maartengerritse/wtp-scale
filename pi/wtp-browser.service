# Chromium in kiosk mode, pointed at the local service above.
# Kept separate so the browser can be restarted without dropping the reader.
[Unit]
Description=WTP Scale kiosk browser
# Give up after 5 failures in 2 minutes so the unit lands in `failed`, which
# is visible, instead of retrying forever and only ever showing `activating`.
# A missing execute bit on kiosk.sh once looped this 1000+ times unnoticed.
StartLimitIntervalSec=120
StartLimitBurst=5
After=wtp-kiosk.service graphical-session.target
Requires=wtp-kiosk.service
PartOf=graphical-session.target

[Service]
Type=simple
# Display is discovered by kiosk.sh: a user service inherits none of the
# desktop session env, and the answer differs between Wayland and X11.
ExecStart=__REPO__/pi/kiosk.sh
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
